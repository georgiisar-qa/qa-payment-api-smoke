# Copy to .env and fill with your OWN test credentials. Never commit .env.
SMOKE_BASE_URL=https://payments.example.com

# payin merchant (S1–S5)
SMOKE_PAYIN_A_BEARER=your_payin_bearer
SMOKE_PAYIN_A_SECRET=your_payin_secret
SMOKE_PAYIN_CCY=USD

# payout key (S7, S12)
SMOKE_PAYOUT_BEARER=your_payout_bearer
SMOKE_PAYOUT_SECRET=your_payout_secret
# SMOKE_PAYOUT_BASE_URL=https://payments.example.com

# ROW merchant for the country stop-list test (S9)
SMOKE_ROW_BEARER=your_row_bearer
SMOKE_ROW_SECRET=your_row_secret

# merchant used for the refund + webhook-signature test (S10)
SMOKE_REFUND_BEARER=your_refund_bearer
SMOKE_REFUND_SECRET=your_refund_secret
SMOKE_REFUND_WEBHOOK_SECRET=your_webhook_secret

# console SSO login (S8)
SMOKE_CORE_URL=https://console.example.com
SMOKE_SSO_USER=your_console_user
SMOKE_SSO_PASS=your_console_pass

# health checks (S11) — comma-separated
SMOKE_HEALTH_URLS=https://payments.example.com/health,https://console.example.com/health
